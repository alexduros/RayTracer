{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug raymini (GUI, minion)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/raymini",
            "args": ["models/minion.off"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "Build"
        },
        {
            "name": "Debug raymini-cli (teapot)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/raymini-cli",
            "args": ["models/teapot.off", "--mode", "normals", "--out", "renders/teapot.png"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "Build"
        }
    ]
}
